FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM docker.io/library/node:26.7.0-bookworm-slim AS frontend-dependencies
WORKDIR /app/src/web
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM frontend-dependencies AS frontend-build
COPY src/web/ ./
COPY deploy/scripts/verify-vite-assets.mjs /tmp/verify-vite-assets.mjs
RUN npm run build
RUN node /tmp/verify-vite-assets.mjs static/web/dist/.vite/manifest.json static/web/dist

FROM docker.io/library/python:3.14.7-slim-bookworm AS python-dependencies
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/app/.venv
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app/src/backend
COPY src/backend/pyproject.toml src/backend/uv.lock ./
RUN uv sync --frozen --no-dev

FROM python-dependencies AS static-collection
COPY src/backend/ /app/src/backend/
COPY src/web/ /app/src/web/
COPY --from=frontend-build /app/src/web/static/web/dist/ /app/src/web/static/web/dist/
RUN DJANGO_SETTINGS_MODULE=bagredex.settings.local \
    uv run --no-dev python manage.py collectstatic --noinput

FROM python-dependencies AS development
RUN uv sync --frozen
ENV PATH=/app/.venv/bin:${PATH}
COPY src/backend/ /app/src/backend/
COPY src/data/fixtures/ /app/src/data/fixtures/
COPY src/data/importer/ /app/src/data/importer/
COPY src/data/overrides/ /app/src/data/overrides/
COPY src/data/releases/ /app/src/data/releases/
COPY src/data/schema/ /app/src/data/schema/
RUN chmod -R a=rX,u+w /app/src/data
COPY src/web/ /app/src/web/
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]

FROM docker.io/library/python:3.14.7-slim-bookworm AS application
ENV PATH=/app/.venv/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN groupadd --system --gid 10001 bagredex \
    && useradd --system --uid 10001 --gid bagredex --home-dir /nonexistent bagredex
WORKDIR /app/src/backend
COPY --from=python-dependencies /app/.venv /app/.venv
COPY src/backend/ ./
COPY src/data/importer/ /app/src/data/importer/
COPY src/data/overrides/ /app/src/data/overrides/
COPY src/data/releases/ /app/src/data/releases/
COPY src/data/schema/ /app/src/data/schema/
RUN chmod -R a=rX,u+w /app/src/data
COPY src/web/ /app/src/web/
COPY --from=frontend-build /app/src/web/static/web/dist/ /app/src/web/static/web/dist/
USER 10001:10001
RUN test -x /app/src/data/importer \
    && test -x /app/src/data/overrides \
    && test -x /app/src/data/releases \
    && test -x /app/src/data/schema \
    && for manifest in /app/src/data/releases/*/manifest.json; do \
         test -r "${manifest}" \
         && release_dir="${manifest%/manifest.json}" \
         && test -r "${release_dir}/sprites/normal/abomasnow.webp"; \
       done
EXPOSE 8000
CMD ["gunicorn", "--bind=0.0.0.0:8000", "--workers=1", "--threads=4", "bagredex.wsgi:application"]

FROM docker.io/library/nginx:1.29.1-alpine AS nginx
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/templates/default.conf.template /etc/nginx/default.conf.template
COPY deploy/nginx/entrypoint.sh /usr/local/bin/bagredex-nginx-entrypoint
COPY --from=static-collection /app/src/backend/staticfiles/ /srv/static/
RUN chmod 0755 /usr/local/bin/bagredex-nginx-entrypoint
USER 101:101
EXPOSE 8080 8443
ENTRYPOINT ["/usr/local/bin/bagredex-nginx-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
