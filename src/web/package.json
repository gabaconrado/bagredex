{
  "name": "bagredex-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "audit:damage": "node audit-damage-release.mjs",
    "generate:damage-parity": "node scripts/run-damage-parity-generator.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.2",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.1",
    "happy-dom": "20.14.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
